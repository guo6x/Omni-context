{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omni-Context held-out authorization v2 (phase-separated)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorized_by",
    "authorized_at",
    "expires_at",
    "benchmark",
    "dataset_variant",
    "allowed_subset",
    "generation_projection_sha256",
    "gold_projection_sha256",
    "product_commit",
    "product_build_sha256",
    "adapter_commit",
    "engine_adapter_commit",
    "formal_runner_commit",
    "preregistration_sha256",
    "scoring_preregistration_sha256",
    "scorer_module_sha256",
    "judge_prompt_sha256",
    "allow_formal_generation",
    "allow_formal_scoring"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "authorized_by": {"type": "string", "minLength": 1},
    "authorized_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "benchmark": {"enum": ["longmemeval", "locomo"]},
    "dataset_variant": {"type": "string", "minLength": 1},
    "allowed_subset": {"type": "string", "minLength": 1},
    "generation_projection_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gold_projection_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "product_commit": {"const": "17dc1d0107b0474de84058205a91b302ba290a74"},
    "product_build_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "adapter_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "engine_adapter_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "formal_runner_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "preregistration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scoring_preregistration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scorer_module_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "judge_prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "allow_formal_generation": {"type": "boolean"},
    "allow_formal_scoring": {"type": "boolean"}
  }
}
