{
  "schema_version": 1,
  "preregistration_version": 1,
  "scoring_protocol": "kimi-longmemeval-judge-v1",
  "benchmark": "longmemeval",
  "dataset_variant": "longmemeval_s_cleaned",
  "judge_provider": "Moonshot",
  "judge_model": "kimi-k2.6",
  "max_logical_calls": 500,
  "max_retries_after_initial": 2,
  "score_based_retry_forbidden": true,
  "max_output_tokens": 10,
  "temperature_control": "provider_default_non_configurable",
  "temperature_parameter_sent": false,
  "temperature_aggregation": {
    "tracked_fields": ["temperature_zero_sent_calls", "temperature_omitted_calls", "temperature_fallback_calls"],
    "control_values": ["fixed_zero", "provider_default_non_configurable", "mixed"],
    "note": "Moonshot API may not accept explicit temperature=0; the parameter is not sent. Per-call tracking reports the actual behavior, and the aggregate is computed as fixed_zero (all calls sent temperature=0), provider_default_non_configurable (all calls fell back), or mixed (combination)."
  },
  "metric_name": "Kimi-K2.6-judged end-to-end LongMemEval-S QA accuracy",
  "valid_judgment_metric_name": "Kimi-K2.6-judged valid-judgment LongMemEval-S QA accuracy",
  "metric_definitions": {
    "total_questions": "results.length",
    "generation_completed": "count of results with status != error",
    "generation_terminal_errors": "count of results with status == error",
    "generation_completion_rate": "generation_completed / total_questions",
    "generation_terminal_error_rate": "generation_terminal_errors / total_questions",
    "kimi_calls": "number of Kimi judge logical calls (only for successful generations)",
    "kimi_valid_labels": "number of non-null judge labels",
    "kimi_judge_errors": "number of null judge labels",
    "kimi_judge_completion_rate": "kimi_valid_labels / generation_completed (null if denominator 0)",
    "kimi_judge_error_rate": "kimi_judge_errors / generation_completed (null if denominator 0)",
    "correct": "number of judge labels == yes",
    "end_to_end_accuracy": "correct / total_questions (generation errors and judge errors both count as incorrect)",
    "valid_judgment_accuracy": "correct / kimi_valid_labels (null if denominator 0)"
  },
  "generation_error_policy": {
    "rule": "generation status=error → do not call Kimi → end-to-end incorrect → generation_terminal_error +1",
    "not_abstention": "Generation terminal errors must NOT be sent to Kimi as abstentions. Only successful generations with empty/null hypothesis are treated as abstentions."
  },
  "judge_prompt_path": "external-eval/scorers/prompts/kimi-longmemeval-judge-v1.txt",
  "judge_prompt_sha256": "6d4cfa724d722553ea79511769fd842afdadfa4cc412de4852dd43ade17448af",
  "judge_schema_path": "external-eval/scorers/schemas/kimi-longmemeval-judge-v1.json",
  "judge_schema_sha256": "e5bab488fa6872c2d4383da61a97509f8fca4d3d16985b96af939508fcd2429f",
  "scorer_module_path": "external-eval/scorers/kimi-longmemeval-v1.mjs",
  "scorer_module_sha256": "54bd9a5c2c13bc6faf2519cdb5ed9755f170a857ee2e344af51b3c63e33c2270",
  "scorer_version": "1",
  "judge_input_fields": ["question_id", "question_type", "question", "reference_answer", "hypothesis", "abstained"],
  "judge_output_fields": ["label"],
  "judge_output_values": ["yes", "no"],
  "official_gpt4o_scoring_performed": false,
  "leaderboard_comparable": false,
  "official_gpt4o_scorer_used": false,
  "sanitized_log_fields": ["question_id", "label", "attempts", "usage", "latency_ms", "error_type", "generation_status"],
  "full_log_fields": ["question_id", "question_type", "question", "reference_answer", "hypothesis", "abstained", "label", "attempts", "usage", "latency_ms", "error_type", "temperature_parameter_sent"],
  "prohibited_log_fields": ["question", "gold", "reference_answer", "full_hypothesis"],
  "call_limit_enforcement": {
    "rule": "kimi_calls <= generation_completed <= 500",
    "note": "Each successful generation produces at most one logical judge result. Provider physical retries tracked separately."
  },
  "formal_status": "NOT AUTHORIZED / NOT RUN",
  "created_before_dataset_access": true,
  "created_before_gold_access": true,
  "created_before_formal_run": true
}
