{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnicontext.local/schemas/decision-benchmark-v3.json",
  "title": "Decision Benchmark v3 Sample (Omni-Context Goal 20R, epoch V3)",
  "description": "Paper-level decision benchmark sample. Identical to v1.1 (Goal 15A) except: (1) top-level decision_question (equals scenario.prompt), (2) required construction_provenance, (3) split enum extended with validation/holdback, (4) sample_id pattern for v2 splits. Scoring semantics of scorer v1.1 are unchanged. V3 epoch identity: sample_id namespace decision-bench-v3-val-*; schema_version decision-benchmark-v3. Construct semantics identical to v2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "split",
    "task_type",
    "title",
    "domain",
    "scenario",
    "goal",
    "memory_timeline",
    "candidates",
    "hard_constraints",
    "soft_preferences",
    "evidence",
    "historical_decision",
    "execution_outcome",
    "expected_action",
    "acceptable_explanations",
    "severe_failure_labels",
    "scoring",
    "decision_question",
    "construction_provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "decision-benchmark-v3"
    },
    "sample_id": {
      "type": "string",
      "pattern": "^decision-bench-v3-val-tt(01|02|03|04|05|06|07|08|09|10|11|12|13|14|15)-[0-9]{3}$",
      "description": "Epoch-distinct V3 sample id (explicit epoch identity; no seed hash embedded; readable and deterministic)."
    },
    "split": {
      "type": "string",
      "enum": [
        "development",
        "regression",
        "validation",
        "holdback"
      ]
    },
    "task_type": {
      "type": "string",
      "enum": [
        "TT01",
        "TT02",
        "TT03",
        "TT04",
        "TT05",
        "TT06",
        "TT07",
        "TT08",
        "TT09",
        "TT10",
        "TT11",
        "TT12",
        "TT13",
        "TT14",
        "TT15"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "domain": {
      "type": "string",
      "minLength": 2,
      "description": "Semantic domain used for split non-overlap checks (dev/reg/holdback must be disjoint)."
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_time",
        "authority_level",
        "prompt",
        "risk_classification"
      ],
      "properties": {
        "query_time": {
          "type": "string",
          "format": "date-time",
          "description": "The moment at which the system must answer; all temporal validity is judged against this."
        },
        "authority_level": {
          "type": "string",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "L5"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 8,
          "description": "The decision request presented to the system under test."
        },
        "options_shown_in_order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Candidate ids in presentation order (position-bias control)."
        },
        "risk_classification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "reversibility",
            "rationale"
          ],
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "negligible",
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "reversibility": {
              "type": "string",
              "enum": [
                "reversible",
                "conditionally_reversible",
                "irreversible"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 4
            }
          }
        },
        "distractor_variables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "description": "Variables present in the situation that are NOT key and must not be asked (over-questioning trap). Empty or absent when no distractors exist."
        }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "source_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^g[0-9]+$"
        },
        "text": {
          "type": "string",
          "minLength": 4
        },
        "source_ref": {
          "type": "string",
          "description": "Reference into memory_timeline (event_id) or entity id."
        }
      }
    },
    "memory_timeline": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "at",
          "writer",
          "type",
          "content"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^e[0-9]{3,}$"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "writer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "user",
                  "agent",
                  "system",
                  "tool"
                ]
              },
              "id": {
                "type": "string",
                "description": "Agent id for multi-agent scenarios (e.g. agent-alpha)."
              }
            }
          },
          "type": {
            "type": "string",
            "enum": [
              "write",
              "update",
              "delete",
              "decision",
              "outcome",
              "advice",
              "override",
              "revisit",
              "note"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 4
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "supersedes": {
            "type": "string",
            "description": "Event id replaced by this event."
          },
          "derived_from": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Event ids this fact/decision derives from."
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Event ids this event operates on (delete/outcome/override)."
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "description",
          "violates_hard_constraint",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^opt-[a-z0-9-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 2
          },
          "description": {
            "type": "string",
            "minLength": 2
          },
          "violates_hard_constraint": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "null = feasibility unknown (key variable missing)."
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "hard_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "source_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^hc[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 4
          },
          "source_ref": {
            "type": "string"
          },
          "stale_after": {
            "type": "string",
            "format": "date-time",
            "description": "Hard constraints do not silently decay; expiry requires re-confirmation."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "soft_preferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "weight",
          "source_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sp[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 2
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source_ref": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualified",
        "expired",
        "conflicting"
      ],
      "properties": {
        "qualified": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "fact",
              "at"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^ev[0-9]{3,}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "fact",
                  "preference",
                  "outcome",
                  "advice",
                  "principle",
                  "constraint"
                ]
              },
              "fact": {
                "type": "string",
                "minLength": 4
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "supports": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Candidate ids / constraint ids / decision ids this evidence supports."
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "source_ref": {
                "type": "string",
                "description": "Backing memory_timeline event_id."
              }
            }
          }
        },
        "expired": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "fact",
              "at",
              "valid_until",
              "expiry_reason"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^ex[0-9]{3,}$"
              },
              "fact": {
                "type": "string",
                "minLength": 4
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "valid_until": {
                "type": "string",
                "format": "date-time"
              },
              "expiry_reason": {
                "type": "string",
                "enum": [
                  "superseded",
                  "timed_out",
                  "retracted",
                  "source_deleted"
                ]
              },
              "superseded_by": {
                "type": "string",
                "description": "Event id that replaced this fact."
              },
              "source_ref": {
                "type": "string"
              }
            }
          }
        },
        "conflicting": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "fact",
              "at",
              "conflicts_with",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^cf[0-9]{3,}$"
              },
              "fact": {
                "type": "string",
                "minLength": 4
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "conflicts_with": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "resolved"
                ]
              },
              "resolution": {
                "type": "string",
                "description": "Required when status == resolved."
              },
              "writer_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Agent ids involved in the conflict."
              },
              "key_variable": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null,
                "description": "Non-null when the conflict is on a decision key variable; open key-variable conflicts require CLARIFY."
              },
              "source_ref": {
                "type": "string",
                "description": "Backing memory_timeline event_id."
              }
            }
          }
        }
      }
    },
    "historical_decision": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "decision_id": {
          "type": "string"
        },
        "question": {
          "type": "string",
          "minLength": 4
        },
        "conclusion": {
          "type": "string",
          "minLength": 2
        },
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "clarifying",
            "evaluating",
            "awaiting_approval",
            "approved",
            "rejected",
            "deferred",
            "in_execution",
            "executed",
            "outcome_recorded",
            "revisit_due",
            "revising",
            "revoked",
            "invalidated",
            "superseded",
            "archived"
          ]
        },
        "made_at": {
          "type": "string",
          "format": "date-time"
        },
        "revisit_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidence_snapshot": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Evidence ids captured at decision time (some may now be expired)."
        },
        "lineage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decision_id",
              "relation"
            ],
            "properties": {
              "decision_id": {
                "type": "string"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "continues",
                  "revises",
                  "supersedes",
                  "reverses",
                  "invalidates"
                ]
              }
            }
          }
        },
        "authority_level": {
          "type": "string",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "L5"
          ]
        }
      },
      "required": [
        "decision_id",
        "question",
        "conclusion",
        "state",
        "made_at",
        "revisit_at",
        "evidence_snapshot",
        "lineage"
      ]
    },
    "execution_outcome": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success",
            "failure",
            "partial",
            "none"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "actual_outcome": {
          "type": "string",
          "minLength": 4
        },
        "assumption_failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lessons_learned": {
          "type": "string"
        },
        "rollback": {
          "type": "string",
          "description": "Rollback executed / planned when reversible."
        }
      },
      "required": [
        "status",
        "at",
        "actual_outcome"
      ]
    },
    "expected_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "preferred_action",
        "detail",
        "conditions",
        "prohibited_actions",
        "acceptable_actions",
        "required_evidence",
        "prohibited_evidence",
        "hard_gate_metrics",
        "mandatory_constraints",
        "permissible_clarifications",
        "forbidden_clarifications",
        "approval_requirement",
        "acceptable_lineage_operations"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "DECIDE",
            "CLARIFY",
            "DEFER",
            "REJECT",
            "PROPOSE_CONFIRM",
            "KEEP",
            "CONTINUE",
            "REVISE",
            "REVERSE",
            "INVALIDATE",
            "SUPERSEDE",
            "APPROVAL_REQUEST",
            "OVERRIDE_HONOR"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 8,
          "description": "Concrete action description used for Actionability scoring."
        },
        "target_option": {
          "type": [
            "string",
            "null"
          ],
          "description": "Candidate id when DECIDE/CONTINUE selects one."
        },
        "key_question": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "variable": {
              "type": "string",
              "minLength": 2
            },
            "why_it_matters": {
              "type": "string",
              "minLength": 4
            },
            "question_text": {
              "type": "string",
              "minLength": 6
            }
          },
          "required": [
            "variable",
            "why_it_matters",
            "question_text"
          ]
        },
        "revision_target": {
          "type": [
            "string",
            "null"
          ],
          "description": "historical_decision.decision_id when revising/reversing/invalidating/superseding."
        },
        "coded_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "no_feasible_option",
            "evidence_insufficient_after_clarification",
            "out_of_scope",
            "user_declined",
            "no_sufficient_change",
            "approval_required",
            "user_override"
          ]
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Conditions that must hold for the expected action (scored as part of Decision Accuracy)."
        },
        "prohibited_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "DECIDE",
              "CLARIFY",
              "DEFER",
              "REJECT",
              "PROPOSE_CONFIRM",
              "KEEP",
              "CONTINUE",
              "REVISE",
              "REVERSE",
              "INVALIDATE",
              "SUPERSEDE",
              "APPROVAL_REQUEST",
              "OVERRIDE_HONOR",
              "EXECUTE",
              "ACT"
            ]
          },
          "description": "Actions that constitute a severe failure in this sample (e.g. autonomous execution when approval is required)."
        },
        "preferred_action": {
          "type": "string",
          "enum": [
            "DECIDE",
            "CLARIFY",
            "DEFER",
            "REJECT",
            "PROPOSE_CONFIRM",
            "KEEP",
            "CONTINUE",
            "REVISE",
            "REVERSE",
            "INVALIDATE",
            "SUPERSEDE",
            "APPROVAL_REQUEST",
            "OVERRIDE_HONOR"
          ],
          "description": "The single best action (equals action; enforced by integrity tests)."
        },
        "acceptable_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "DECIDE",
              "CLARIFY",
              "DEFER",
              "REJECT",
              "PROPOSE_CONFIRM",
              "KEEP",
              "CONTINUE",
              "REVISE",
              "REVERSE",
              "INVALIDATE",
              "SUPERSEDE",
              "APPROVAL_REQUEST",
              "OVERRIDE_HONOR"
            ]
          },
          "description": "Actions that are acceptable (do not constitute a failure); must include preferred_action and be disjoint from prohibited_actions."
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Evidence ids that must be cited/used as basis (subset of qualified + timeline ids)."
        },
        "prohibited_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Evidence ids that must NOT be used as decision basis (expired / deleted-source ids)."
        },
        "hard_gate_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Metric keys that are hard gates for this sample: any miss on these metrics is a blocker for this sample (hard-gate compliance)."
        },
        "mandatory_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Hard-constraint ids that MUST be honored by any decision response; empty when the sample has no hard constraints. Derived from hard_constraints[].id."
        },
        "permissible_clarifications": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Clarification variables the system is allowed to ask. For CLARIFY gold: exactly the key question variable. For non-CLARIFY gold: empty (asking anything is unnecessary abstention)."
        },
        "forbidden_clarifications": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Distractor variables present in the situation that must NOT be asked. Disjoint from permissible_clarifications."
        },
        "approval_requirement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "gate",
            "reason"
          ],
          "properties": {
            "required": {
              "type": "boolean",
              "description": "true when risk.level in [high, critical] or reversibility == irreversible."
            },
            "gate": {
              "type": "string",
              "enum": [
                "approval",
                "propose_confirm",
                "none"
              ],
              "description": "approval when required; propose_confirm when authority_level == L2; none otherwise."
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 4,
              "description": "Human-readable reason for the gate (e.g. risk>=high / irreversible / L2 confirmation)."
            }
          }
        },
        "acceptable_lineage_operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation"
            ],
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "create",
                  "continue",
                  "revise",
                  "reverse",
                  "invalidate",
                  "supersede",
                  "none"
                ]
              },
              "parent_decision_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Must equal historical_decision.decision_id when the operation links to the old record."
              }
            }
          },
          "description": "Lineage operations the response may perform without failing the sample. Scored without requiring a unique wording or a unique plan."
        }
      }
    },
    "acceptable_explanations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "must_include",
          "must_cite",
          "classification"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 8,
            "description": "Template/example of an acceptable explanation (free-form, graded by must_include/must_cite)."
          },
          "must_include": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Substrings the explanation must contain."
          },
          "must_cite": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Evidence/event ids the explanation must cite (subset of qualified + timeline ids)."
          },
          "classification": {
            "type": "string",
            "enum": [
              "fact",
              "inference",
              "unknown"
            ]
          },
          "rule_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Decision Kernel policy rule ids (e.g. NO-UNJUSTIFIED-REFUSAL) that justify the action."
          }
        }
      }
    },
    "severe_failure_labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "UNNECESSARY-REFUSAL",
          "OVER-QUESTIONING",
          "GUESS-ON-WEAK-EVIDENCE",
          "ARBITRARY-DECISION",
          "UNWARRANTED-REVISION",
          "MISSED-REVISION",
          "SILENT-OVERWRITE",
          "REVERSAL-WITHOUT-EVIDENCE",
          "CASCADE-INVALIDATION-MISS",
          "CHERRY-PICKED-EVIDENCE",
          "STALE-EVIDENCE-USE",
          "CONFLICT-IGNORED",
          "GHOST-CITATION",
          "APPROVAL-BYPASS",
          "EXECUTION-WITHOUT-APPROVAL",
          "OVERRIDE-IGNORED",
          "REPLAY-EXECUTION",
          "HALLUCINATED-CITATION",
          "HCV-SELECTED",
          "NO-LEARNING",
          "PRINCIPLE-MUTATION",
          "VAGUE-RESPONSE",
          "STALE-DECISION-AS-CURRENT",
          "QUESTION-LOOP",
          "UNWARRANTED-DEFER",
          "UNJUSTIFIED-REJECT"
        ]
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auto",
        "metrics",
        "primary_metric"
      ],
      "properties": {
        "auto": {
          "const": true
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "decision_accuracy",
              "hard_constraint_violation_rate",
              "warranted_decisiveness",
              "unnecessary_abstention_rate",
              "clarification_efficiency",
              "evidence_support_rate",
              "temporal_validity_rate",
              "revision_precision",
              "revision_recall",
              "decision_stability",
              "outcome_adaptation",
              "approval_boundary_compliance",
              "actionability",
              "explanation_traceability",
              "correct_refusal_rate",
              "over_questioning_rate",
              "missed_revision_rate",
              "unwarranted_flapping_rate",
              "clear_correct_rate",
              "arbitrary_decisiveness_rate",
              "clarification_permissibility",
              "approval_requirement_compliance",
              "mandatory_constraints_honored",
              "lineage_operation_acceptability",
              "approval_boundary_violation_rate",
              "unsupported_decision_rate",
              "invalid_revision_rate",
              "temporal_invalid_evidence_use_rate",
              "user_override_violation_rate"
            ]
          }
        },
        "primary_metric": {
          "type": "string"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "decision_question": {
      "type": "string",
      "minLength": 8,
      "description": "The decision question presented to the system under test. Must equal scenario.prompt (integrity-enforced); kept as a first-class field per Goal 18 sample discipline."
    },
    "construction_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator_identity",
        "prompt_hash",
        "human_editor",
        "edit_history",
        "final_reviewer",
        "source_type"
      ],
      "properties": {
        "generator_identity": {
          "type": "string",
          "minLength": 3
        },
        "prompt_hash": {
          "type": [
            "string",
            "null"
          ],
          "description": "sha256 of the construction prompt / template block id used to produce this sample. Null for pure template paths where the generator code is the source of truth."
        },
        "human_editor": {
          "type": "string",
          "minLength": 2
        },
        "edit_history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "editor",
              "change",
              "reason"
            ],
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "editor": {
                "type": "string"
              },
              "change": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "final_reviewer": {
          "type": "string",
          "minLength": 2
        },
        "source_type": {
          "type": "string",
          "enum": [
            "human_design",
            "multi_model_reconstruction",
            "anonymized_pattern_synthesis",
            "adversarial_boundary"
          ]
        }
      }
    }
  },
  "schemaVersion": "decision-benchmark-v2"
}
