          "insight_recall": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "blind_spot_detection": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "constraint_awareness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "actionability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "goal_alignment": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "option_comparison": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "risk_awareness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "internal_consistency": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "overall_quality": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
