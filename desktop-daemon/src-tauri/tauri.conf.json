{
  "$schema": "https://schema.tauri.app/config/1.0.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "",
    "devPath": "http://localhost:3000",
    "distDir": "../out"
  },
  "package": {
    "productName": "Omni-Context",
    "version": "0.1.0"
  },
  "tauri": {
    "windows": [
      {
        "label": "main",
        "title": "Omni-Context",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "fileDropEnabled": true,
        "theme": "Dark"
      },
      {
        "label": "hud",
        "url": "index.html",
        "title": "Omni-Context HUD",
        "width": 360,
        "height": 140,
        "x": 40,
        "y": 80,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    },
    "updater": {
      "active": true,
      "endpoints": ["https://github.com/guo6x/Omni-context/releases/latest/download/latest.json"],
      "dialog": false,
      "pubkey": "RWSKgdxaE8QA/rfPk1VS+gUJLORMPY8SDxRPVvFT47aovkqzo1QqON76"
    },
    "allowlist": {
      "fs": {
        "readFile": true,
        "scope": ["**"]
      },
      "path": {
        "all": true
      },
      "shell": {
        "open": true
      },
      "window": {
        "all": true
      },
      "clipboard": {
        "all": true
      }
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:3000 http://127.0.0.1:3000 ws://localhost:3000 ws://127.0.0.1:3000 http://localhost:3001 http://127.0.0.1:3001; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'"
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.omni-context.app",
      "resources": [
        "brain-server/**/*"
      ],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "category": "DeveloperTool",
      "shortDescription": "全域物理级 AI 记忆操作系统",
      "longDescription": "Omni-Context - 一个 OS 级别的常驻 AI 记忆中枢，融合了 Screenpipe 的静默抓取能力、GraphRAG 的知识图谱范式和 Letta 的多级内存架构。",
      "copyright": "© 2024 Omni-Context Team",
      "deb": {
        "depends": [
          "libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libssl3",
          "libayatana-appindicator3-1",
          "librsvg2-2"
        ]
      },
      "macOS": {
        "exceptionDomain": "",
        "signingIdentity": null,
        "minimumSystemVersion": "10.15"
      },
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    }
  }
}
