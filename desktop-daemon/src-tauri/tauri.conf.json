{
  "$schema": "https://schema.tauri.app/config/1.0.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:3000",
    "distDir": "../out"
  },
  "package": {
    "productName": "Omni-Context",
    "version": "0.1.0"
  },
  "tauri": {
    "windows": [
      {
        "title": "Omni-Context",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.omni-context.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "category": "DeveloperTool",
      "shortDescription": "全域物理级 AI 记忆操作系统",
      "longDescription": "Omni-Context - 一个 OS 级别的常驻 AI 记忆中枢，融合了 Screenpipe 的静默抓取能力、GraphRAG 的知识图谱范式和 Letta 的多级内存架构。",
      "copyright": "© 2024 Omni-Context Team",
      "deb": {
        "depends": []
      },
      "macOS": {
        "exceptionDomain": ""
      },
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    }
  }
}
