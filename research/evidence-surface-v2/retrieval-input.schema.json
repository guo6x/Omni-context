{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guo6x/Omni-context/research/evidence-surface-v2/retrieval-input.schema.json",
  "title": "Evidence Surface V2 retriever-only input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "query",
    "candidates",
    "prior_state",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "const": "evidence-surface-v2-retrieval-input-v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^case-[a-f0-9]{16}$"
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object"
      }
    },
    "prior_state": {
      "type": [
        "object",
        "null"
      ]
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "source_event_id",
          "role",
          "fact",
          "currentness",
          "supports_candidates",
          "at"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "pattern": "^doc-[a-f0-9]{16}$"
          },
          "source_event_id": {
            "type": "string",
            "pattern": "^src-[a-f0-9]{16}$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "fact": {
            "type": "string",
            "minLength": 1
          },
          "currentness": {
            "type": "string",
            "minLength": 1
          },
          "supports_candidates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
