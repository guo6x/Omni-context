{
  "name": "omni-context-brain-server",
  "version": "1.0.0",
  "description": "Omni-Context Brain Server - AI记忆中枢",
  "main": "dist/mcp-server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/mcp-server.ts",
    "build": "tsc",
    "start": "node dist/mcp-server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "api": "tsx src/api-server.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "schema:generate": "tsx scripts/generate-schema-artifacts.ts",
    "schema:check": "tsx scripts/generate-schema-artifacts.ts && git diff --exit-code -- ../schema_manifest.json ../mcp_tool_manifest.json ../generated_capability_matrix.md ../shared/generated-domain-types.ts ../mobile-app/src/types/generated-domain.ts"
  },
  "keywords": [
    "ai",
    "mcp",
    "graphrag",
    "memory"
  ],
  "author": "Omni-Context Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@mozilla/readability": "^0.6.0",
    "@types/pdf-parse": "^1.1.5",
    "@xenova/transformers": "^2.17.2",
    "archiver": "^7.0.1",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.7.0",
    "pdf-parse": "^2.4.5",
    "sqlite-vec": "^0.1.9",
    "sqlite3": "^5.1.7",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "uuid": "^11.1.1",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "overrides": {
    "protobufjs": "7.6.3",
    "tar": "7.5.16",
    "hono": "4.12.29"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.11.16",
    "@types/sqlite3": "^3.1.11",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
