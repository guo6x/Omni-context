# Omni-Context environment template
#
# Copy to `.env` (or your shell profile) and fill in real values locally.
# NEVER commit a real `.env`; only this example file may be tracked.
# All variables are OPTIONAL; server defaults are shown in comments.
# API keys are only required when using remote LLM/embedding providers.

# --- Brain Server (brain-server/) ---
# Server
# HOST=127.0.0.1
# PORT=3001
# DB_PATH=./data/omni-context.db
# NODE_ENV=development

# Local auth (optional; the desktop app generates its own token at runtime)
# LOCAL_API_TOKEN=your-local-api-token-placeholder
# PAIR_CODE=your-pair-code-placeholder

# LLM (agent loop / graphrag). Defaults point at a local Ollama-compatible
# endpoint; no key is required when running fully local.
# LLM_API_URL=http://localhost:11434/v1
# LLM_API_KEY=your-llm-api-key-placeholder
# LLM_MODEL=qwen2.5:7b

# Embeddings ("local" mode is the default; "api" mode needs a provider key)
# EMBEDDING_MODE=local
# EMBEDDING_LOCAL_MODEL=Xenova/multilingual-e5-large
# EMBEDDING_LOCAL_MODEL_PATH=./models
# EMBEDDING_API_URL=https://api.example.com/v1
# EMBEDDING_API_KEY=your-embedding-api-key-placeholder
# EMBEDDING_API_MODEL=your-embedding-model-placeholder

# Limits / tuning
# INGEST_MAX_BYTES=31457280
# INSIGHT_INTERVAL_MS=600000
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300
# CORS_ORIGINS=http://localhost:1420,http://localhost:5173
# MCP_EMBEDDING_TIMEOUT_MS=2500
# MCP_RERANK_TIMEOUT_MS=2500

# Evaluation mode: when set to 1, embedding/index failures are treated as
# hard errors instead of graceful degradation (benchmark-facing, off by default)
# OMNI_EVALUATION_MODE=0

# --- Desktop app (desktop-daemon/) ---
# NEXT_PUBLIC_BRAIN_URL=http://localhost:3001

# --- Hardware (hardware/ ESP32 UDP bridge) ---
# OMNI_UDP_BIND=0.0.0.0:9090
